@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using System.Collections.Generic
@using System.Linq
@{
    // Aggregate tags from all blog posts under this page
    var tagCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    var allPosts = Model.Children.Where(x => x.ContentType.Alias == "blogPost");
    foreach (var post in allPosts)
    {
        var tags = post.Value<IEnumerable<string>>("tags") ?? Enumerable.Empty<string>();
        foreach (var tag in tags)
        {
            var key = tag.Trim().ToLowerInvariant();
            if (!string.IsNullOrEmpty(key))
                tagCounts[key] = tagCounts.ContainsKey(key) ? tagCounts[key] + 1 : 1;
        }
    }

    if (tagCounts.Count == 0) { return; }

    int minCount = tagCounts.Values.Min();
    int maxCount = tagCounts.Values.Max();
    double minSize = 0.75;  // rem
    double maxSize = 2.0;   // rem

    // Interpolate from muted cyan (#7fb5cc) to bright cyan (#00d4ff)
    // All colors are high-contrast on the dark tag-cloud background
    int lowR = 127, lowG = 181, lowB = 204;
    int highR = 0,  highG = 212, highB = 255;
}

<section class="tag-cloud-section">
    <div class="container">
        <h2 class="tag-cloud-heading">Explore by Topic</h2>
        <div class="tag-cloud" role="navigation" aria-label="Tag cloud">
            @foreach (var kvp in tagCounts.OrderByDescending(k => k.Value))
            {
                double ratio = maxCount == minCount ? 1.0 : (double)(kvp.Value - minCount) / (maxCount - minCount);
                double fontSize = minSize + ratio * (maxSize - minSize);
                int r = (int)Math.Round(lowR + ratio * (highR - lowR));
                int g = (int)Math.Round(lowG + ratio * (highG - lowG));
                int b = (int)Math.Round(lowB + ratio * (highB - lowB));
                string color = $"#{r:X2}{g:X2}{b:X2}";
                string sizeStr = fontSize.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                <span class="tag-cloud-item"
                      style="font-size: @(sizeStr)rem; color: @color;"
                      title="@kvp.Value post@(kvp.Value == 1 ? "" : "s")">
                    @kvp.Key
                    <sup class="tag-cloud-count">@kvp.Value</sup>
                </span>
            }
        </div>
    </div>
</section>
