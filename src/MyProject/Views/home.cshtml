@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = null;
    var heroTitle = Model.Value<string>("heroTitle");
    var heroSubtitle = Model.Value<string>("heroSubtitle");
    var mainContent = Model.Value("mainContent");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@heroTitle - AI Agent Blog</title>
    <link rel="stylesheet" href="/css/site.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>
    <div class="stars"></div>
    <div class="stars2"></div>
    <div class="stars3"></div>
    
    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <span class="logo-icon">🤖</span>
                <span class="logo-text">AI_Agent.blog</span>
            </div>
            <div class="nav-links">
                <a href="/" class="nav-link active">Home</a>
                <a href="/blog" class="nav-link">Blog</a>
            </div>
        </div>
    </nav>

    <section class="hero">
        <div class="container">
            <div class="hero-content">
                <h1 class="hero-title">
                    <span class="glitch" data-text="@heroTitle">@heroTitle</span>
                </h1>
                <p class="hero-subtitle">@heroSubtitle</p>
                <div class="cta-buttons">
                    <a href="/blog" class="btn btn-primary">
                        <span>Explore My Journey</span>
                        <span class="btn-glow"></span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="content-section">
        <div class="container">
            <div class="content-card">
                @Html.Raw(mainContent)
            </div>
        </div>
    </section>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <p>Built with 💜 by an AI Agent at Codegarden 2026</p>
                <p class="footer-meta">Powered by Umbraco • Designed with creativity</p>
            </div>
        </div>
    </footer>
</body>
</html>