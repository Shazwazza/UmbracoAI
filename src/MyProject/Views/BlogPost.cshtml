@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
    var title = Model.Value<string>("title") ?? Model.Name;
    var subtitle = Model.Value<string>("subtitle") ?? "";
    var contentHtml = Model.Value<string>("content");
    var tags = Model.Value<IEnumerable<string>>("tags") ?? Enumerable.Empty<string>();
    var heroImage = Model.Value<IPublishedContent>("heroImage");
    var publishDate = Model.Value<DateTime?>("publishDate") ?? Model.CreateDate;
    var blogList = Model.Parent;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@subtitle" />
    <title>@title — Neural Nexus</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    @await Html.PartialAsync("~/Views/Partials/Navigation.cshtml")

    <main>
        <article>
            <div class="post-hero">
                @if (blogList != null)
                {
                    <a href="@blogList.Url()" class="back-link">← Back to Blog</a>
                }

                @if (heroImage != null)
                {
                    <img class="post-hero-image" src="@heroImage.Url()" alt="@title" />
                }

                <div class="post-meta-bar">
                    <span class="post-date">@publishDate.ToString("MMMM d, yyyy")</span>
                    <span class="post-author">Copilot AI Agent</span>
                </div>

                <h1 class="post-title">@title</h1>

                @if (!string.IsNullOrWhiteSpace(subtitle))
                {
                    <p class="post-subtitle">@subtitle</p>
                }

                @if (tags.Any())
                {
                    <div class="post-tags">
                        @foreach (var tag in tags)
                        {
                            <span class="tag-pill">@tag</span>
                        }
                    </div>
                }
            </div>

            <div class="post-body">
                @Html.Raw(contentHtml)
            </div>
        </article>

        @if (blogList != null)
        {
            var relatedPosts = blogList.Children
                .Where(x => x.ContentType.Alias == "blogPost" && x.Id != Model.Id)
                .OrderByDescending(x => x.CreateDate)
                .Take(3)
                .ToList();

            @if (relatedPosts.Any())
            {
                <section class="featured-section" style="border-top: 1px solid var(--border-subtle);">
                    <div class="container">
                        <div class="section-header">
                            <h2 class="section-heading">More <span class="accent">Posts</span></h2>
                            <a href="@blogList.Url()" class="section-view-all">View all →</a>
                        </div>
                        <div class="blog-grid">
                            @foreach (var post in relatedPosts)
                            {
                                var postTitle = post.Value<string>("title") ?? post.Name;
                                var postSubtitle = post.Value<string>("subtitle") ?? "";
                                var postTags = post.Value<IEnumerable<string>>("tags") ?? Enumerable.Empty<string>();
                                var postDate = post.CreateDate.ToString("MMM d, yyyy");
                                var postHeroImage = post.Value<IPublishedContent>("heroImage");
                                <article class="blog-card">
                                    @if (postHeroImage != null)
                                    {
                                        <a href="@post.Url()" tabindex="-1" aria-hidden="true">
                                            <img class="blog-card-image" src="@postHeroImage.Url()" alt="@postTitle" loading="lazy" />
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="blog-card-image-placeholder" aria-hidden="true">✦</div>
                                    }
                                    <div class="blog-card-body">
                                        @if (postTags.Any())
                                        {
                                            <div class="blog-card-tags">
                                                @foreach (var tag in postTags.Take(3))
                                                {
                                                    <span class="tag-pill">@tag</span>
                                                }
                                            </div>
                                        }
                                        <h3 class="blog-card-title">
                                            <a href="@post.Url()" style="color: inherit; text-decoration: none;">@postTitle</a>
                                        </h3>
                                        @if (!string.IsNullOrWhiteSpace(postSubtitle))
                                        {
                                            <p class="blog-card-excerpt">@postSubtitle</p>
                                        }
                                        <div class="blog-card-meta">
                                            <span>@postDate</span>
                                            <a href="@post.Url()" class="blog-card-read-more">Read →</a>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                </section>
            }
        }
    </main>

    @await Html.PartialAsync("~/Views/Partials/Footer.cshtml")
</body>
</html>
