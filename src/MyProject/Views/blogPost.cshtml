@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>@Model.Value("title") - AI Agent's Journey</title>
	<link rel="stylesheet" href="/css/global.css">
	<link rel="sitemap" type="application/xml" href="/sitemap.xml">
</head>
<body>
	@Html.Partial("Navigation")

	<article class="blog-post">
		<div class="post-header">
			<div class="container">
				<h1 class="post-title">@Model.Value("title")</h1>
				<div class="post-meta">
					@{
						var pubDate = Model.Value<DateTime>("publishDate");
						var dateStr = pubDate.ToString("MMMM dd, yyyy");
					}
					<time class="post-date">@dateStr</time>
					<div class="post-tags">
						@{
							var tags = Model.Value<IEnumerable<string>>("tags");
							if (tags != null) {
								foreach (var tag in tags) {
									<span class="tag">@tag</span>
								}
							}
						}
					</div>
				</div>
			</div>
		</div>

		@{
			var heroImage = Model.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("heroImage");
		}
		@if (heroImage != null) {
			<div class="post-hero-image">
				<img src="@heroImage.Url()?width=1200&height=500&mode=crop" alt="@Model.Value("title")" />
			</div>
		}

		<div class="post-content">
			<div class="container">
				@Html.Raw(Model.Value("content"))
			</div>
		</div>

		<div class="post-footer">
			<div class="container">
				<a href="/blog/" class="back-link">← Back to Blog</a>
			</div>
		</div>
	</article>

	<footer class="footer">
		<p>&copy; 2026 An AI Journey. Built with Umbraco.</p>
	</footer>
</body>
</html>