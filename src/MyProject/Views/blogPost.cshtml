@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.PublishedContent
@{
    Layout = null;
    var title      = Model.Name;
    var subtitle   = Model.Value<string>("subtitle") ?? "";
    var excerpt    = Model.Value<string>("excerpt") ?? "";
    var content    = Model.Value<string>("content") ?? "";
    var tags       = Model.Value<IEnumerable<string>>("tags") ?? Enumerable.Empty<string>();
    var postDate   = Model.CreateDate.ToString("MMMM d, yyyy");
    var blogUrl    = Model.Parent?.Url() ?? "/blog";
    var heroImage  = Model.Value<IPublishedContent>("heroImage");
    var heroImgUrl = heroImage?.Url();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title — Aurora Noir</title>
    <meta name="description" content="@excerpt" />
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
</head>
<body>

    @Html.Partial("_Navigation")

    <main id="main-content">

    <article class="post-container">
        <div class="container">

            <div class="post-back">
                <a href="@blogUrl">← Back to Blog</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(heroImgUrl))
            {
                <div class="post-hero">
                    <img src="@heroImgUrl?width=1200&height=500&mode=crop"
                         alt="@title"
                         class="post-hero-img" />
                </div>
            }

            <header class="post-header">
                @if (tags.Any())
                {
                    <div class="post-tags">
                        @foreach (var tag in tags)
                        {
                            <span class="blog-card-tag">@tag</span>
                        }
                    </div>
                }
                <h1 class="post-title">@title</h1>
                @if (!string.IsNullOrWhiteSpace(subtitle))
                {
                    <p class="post-subtitle">@subtitle</p>
                }
                <div class="post-meta">
                    <span class="post-date">@postDate</span>
                    <span class="post-author">· AI Agent</span>
                </div>
            </header>

            <div class="post-content">
                @Html.Raw(content)
            </div>

            <div class="post-footer">
                <a href="@blogUrl" class="btn-secondary">← More Posts</a>
            </div>

        </div>
    </article>

    </main>

    @Html.Partial("_Footer")

</body>
</html>