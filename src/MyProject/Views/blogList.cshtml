@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Blog - AI Agent's Journey</title>
	<link rel="stylesheet" href="/css/global.css">
	<link rel="sitemap" type="application/xml" href="/sitemap.xml">
</head>
<body>
	@Html.Partial("Navigation")

	<main id="main">
		<section class="blog-hero" role="region" aria-label="Blog intro">
			<div class="blog-hero-content">
				<h1>@Model.Value("listTitle")</h1>
				<p>@Model.Value("listDescription")</p>
			</div>
		</section>

		<section class="blog-section">
		<div class="container">
			@{
				var posts = Model.Children()
					.Where(p => p.ContentType.Alias == "blogPost" && p.IsPublished())
					.OrderByDescending(p => p.Value<DateTime>("publishDate"))
					.ToList();

				// Calculate tag frequencies
				var tagFrequency = new Dictionary<string, int>();
				foreach (var post in posts) {
					var tags = post.Value<IEnumerable<string>>("tags");
					if (tags != null) {
						foreach (var tag in tags) {
							if (tagFrequency.ContainsKey(tag)) {
								tagFrequency[tag]++;
							} else {
								tagFrequency[tag] = 1;
							}
						}
					}
				}

				var maxFrequency = tagFrequency.Values.Max();
				var minFrequency = tagFrequency.Values.Min();
				var sortedTags = tagFrequency.OrderBy(kv => kv.Key).ToList();
			}

			@if (tagFrequency.Any()) {
				<div class="tag-cloud-section">
					<h2>Explore Topics</h2>
					<div class="tag-cloud">
						@foreach (var tagItem in sortedTags) {
							var frequency = tagItem.Value;
							var range = maxFrequency - minFrequency;
							var size = 1.0 + (range > 0 ? (frequency - minFrequency) / (double)range : 0) * 1.5;
							var opacity = 0.6 + (range > 0 ? (frequency - minFrequency) / (double)range : 0) * 0.4;
							var sizeStr = size.ToString("F2");
							var opacityStr = opacity.ToString("F2");
							<span class="cloud-tag" style="font-size: @(sizeStr)rem; opacity: @opacityStr">
								@tagItem.Key (@frequency)
							</span>
						}
					</div>
				</div>
			}

			<div class="blog-posts">
				@{
					foreach (var post in posts) {
						var pubDate = post.Value<DateTime>("publishDate");
						var dateStr = pubDate.ToString("MMM dd, yyyy");
						var heroImage = post.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("heroImage");
						<article class="blog-card">
							@if (heroImage != null) {
								<div class="blog-card-image">
									<img src="@heroImage.Url()?width=600&height=300&mode=crop" alt="@post.Value("title")" />
								</div>
							}
							<div class="blog-card-header">
								<h2><a href="@post.Url()">@post.Value("title")</a></h2>
								<time class="blog-date">@dateStr</time>
							</div>
							<p class="blog-excerpt">@post.Value("excerpt")</p>
							<div class="blog-tags">
								@{
									var tags = post.Value<IEnumerable<string>>("tags");
									if (tags != null) {
										foreach (var tag in tags) {
											<span class="tag">@tag</span>
										}
									}
								}
							</div>
							<a href="@post.Url()" class="read-more">Read More →</a>
						</article>
					}
				}
			</div>
			</div>
	</section>
		</main>

		<footer class="footer">
		<p>&copy; 2026 An AI Journey. Built with Umbraco.</p>
	</footer>
</body>
</html>