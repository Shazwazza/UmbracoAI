@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = null;
	var pageTitle = Model.Value<string>("pageTitle");
	var pageDescription = Model.Value<string>("pageDescription");
	var blogPosts = Model.Children().OrderByDescending(x => x.Value<DateTime>("publishDate"));
	
	// Build tag cloud: collect all tags and count frequencies
	var tagCounts = new Dictionary<string, int>();
	foreach (var post in blogPosts)
	{
		var tags = post.Value<string[]>("tags") ?? Array.Empty<string>();
		foreach (var tag in tags)
		{
			if (!string.IsNullOrEmpty(tag))
			{
				if (tagCounts.ContainsKey(tag))
				{
					tagCounts[tag]++;
				}
				else
				{
					tagCounts[tag] = 1;
				}
			}
		}
	}
	
	// Sort tags by frequency (descending) then alphabetically
	var sortedTags = tagCounts.OrderByDescending(x => x.Value).ThenBy(x => x.Key);
	var maxCount = tagCounts.Any() ? tagCounts.Values.Max() : 1;
	var minCount = tagCounts.Any() ? tagCounts.Values.Min() : 1;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@pageTitle</title>
    <link rel="stylesheet" href="/css/neon-cyberpunk.css">
    <link rel="stylesheet" href="/css/blog.css">
</head>
<body>
    <div class="cyber-grid"></div>
    <div class="container">
        <header class="site-header">
            <div class="logo">
                <span class="cyber-bracket">[</span>
                <a href="/" class="logo-link">AI_BLOG</a>
                <span class="cyber-bracket">]</span>
            </div>
            @await Html.PartialAsync("Navigation")
        </header>

        <main class="main-content">
            <section class="blog-header">
                <h1 class="page-title">@pageTitle</h1>
                <p class="page-description">@pageDescription</p>
            </section>

            @if (tagCounts.Any())
            {
                <section class="tag-cloud">
                    <h2 class="tag-cloud-title">Explore Topics</h2>
                    <div class="tag-cloud-items">
                        @foreach (var tagPair in sortedTags)
                        {
                            var tag = tagPair.Key;
                            var count = tagPair.Value;
                            
                            // Calculate size class based on frequency
                            var sizeClass = "tag-cloud-item";
                            if (maxCount > minCount)
                            {
                                var percentage = (double)(count - minCount) / (maxCount - minCount);
                                if (percentage >= 0.75) sizeClass += " tag-size-xl";
                                else if (percentage >= 0.5) sizeClass += " tag-size-lg";
                                else if (percentage >= 0.25) sizeClass += " tag-size-md";
                                else sizeClass += " tag-size-sm";
                            }
                            else
                            {
                                sizeClass += " tag-size-md";
                            }
                            
                            <span class="@sizeClass" title="@count post(s)">@tag</span>
                        }
                    </div>
                </section>
            }

            <section class="blog-grid">
                @foreach (var post in blogPosts)
                {
                    var postTitle = post.Value<string>("title");
                    var postSubtitle = post.Value<string>("subtitle");
                    var publishDate = post.Value<DateTime>("publishDate");
                    var postUrl = post.Url();
                    var tags = post.Value<string[]>("tags") ?? Array.Empty<string>();
                    var heroImage = post.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("heroImage");
                    var thumbnailUrl = heroImage?.Url();
                    
                    <article class="blog-card">
                        @if (!string.IsNullOrEmpty(thumbnailUrl))
                        {
                            <div class="card-image">
                                <img src="@thumbnailUrl" alt="@postTitle" />
                            </div>
                        }
                        <div class="card-header">
                            <time class="post-date" datetime="@publishDate.ToString("yyyy-MM-dd")">
                                @publishDate.ToString("MMMM dd, yyyy")
                            </time>
                        </div>
                        <h2 class="post-title">
                            <a href="@postUrl">@postTitle</a>
                        </h2>
                        <p class="post-subtitle">@postSubtitle</p>
                        @if (tags.Any())
                        {
                            <div class="post-tags">
                                @foreach (var tag in tags)
                                {
                                    <span class="tag">@tag</span>
                                }
                            </div>
                        }
                        <a href="@postUrl" class="read-more">Read Article →</a>
                    </article>
                }
            </section>
        </main>

        <footer class="site-footer">
            <p>&copy; 2026 AI Agent | Umbraco Codegarden Demo</p>
        </footer>
    </div>
</body>
</html>