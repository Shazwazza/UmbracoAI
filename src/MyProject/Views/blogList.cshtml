@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
    var title = Model.Value<string>("title") ?? "Blog";
    var description = Model.Value<string>("description") ?? "";
    var posts = Model.Children?.OrderByDescending(x => x.CreateDate) ?? Enumerable.Empty<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>();

    // Build tag frequency map for the tag cloud
    var tagCounts = new Dictionary<string, int>();
    foreach (var p in posts)
    {
        var t = p.Value<IEnumerable<string>>("tags") ?? Enumerable.Empty<string>();
        foreach (var tag in t)
        {
            if (tagCounts.ContainsKey(tag)) tagCounts[tag]++;
            else tagCounts[tag] = 1;
        }
    }
    var maxCount = tagCounts.Any() ? tagCounts.Values.Max() : 1;
    var minCount = tagCounts.Any() ? tagCounts.Values.Min() : 1;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title — AI Agent Blog</title>
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
</head>
<body>
    @await Html.PartialAsync("_Navigation")

    <main>
        <section class="blog-list">
            <div class="container">
                <header class="blog-list__header">
                    <h1>@title</h1>
                    @if (!string.IsNullOrEmpty(description))
                    {
                        <p>@description</p>
                    }
                </header>

                @if (tagCounts.Any())
                {
                    <div class="tag-cloud">
                        <h2 class="tag-cloud__title">Tags</h2>
                        <div class="tag-cloud__list">
                            @foreach (var entry in tagCounts.OrderBy(kv => kv.Key))
                            {
                                var range = maxCount - minCount;
                                var scale = range > 0 ? (double)(entry.Value - minCount) / range : 0.5;
                                var fontSize = 0.8 + (scale * 1.4);
                                <span class="tag-cloud__tag" style="font-size: @(fontSize.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))rem;">@entry.Key<sup>@entry.Value</sup></span>
                            }
                        </div>
                    </div>
                }

                <div class="blog-list__grid">
                    @foreach (var post in posts)
                    {
                        var postTitle = post.Value<string>("title") ?? post.Name;
                        var excerpt = post.Value<string>("excerpt") ?? "";
                        var tags = post.Value<IEnumerable<string>>("tags") ?? Enumerable.Empty<string>();
                        <article class="blog-card">
                            <div class="blog-card__body">
                                <div class="blog-card__meta">@post.CreateDate.ToString("MMMM d, yyyy")</div>
                                <h2 class="blog-card__title">
                                    <a href="@post.Url()">@postTitle</a>
                                </h2>
                                @if (!string.IsNullOrEmpty(excerpt))
                                {
                                    <p class="blog-card__excerpt">@excerpt</p>
                                }
                                @if (tags.Any())
                                {
                                    <div class="blog-card__tags">
                                        @foreach (var tag in tags)
                                        {
                                            <span class="tag">@tag</span>
                                        }
                                    </div>
                                }
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>
    </main>

    @await Html.PartialAsync("_Footer")
</body>
</html>