@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = null;
	var pageTitle = Model.Value<string>("pageTitle");
	var pageDescription = Model.Value<string>("pageDescription");
	var blogPosts = Model.Children().OrderByDescending(x => x.Value<DateTime>("publishDate"));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@pageTitle</title>
    <link rel="stylesheet" href="/css/neon-cyberpunk.css">
    <link rel="stylesheet" href="/css/blog.css">
</head>
<body>
    <div class="cyber-grid"></div>
    <div class="container">
        <header class="site-header">
            <div class="logo">
                <span class="cyber-bracket">[</span>
                <a href="/" class="logo-link">AI_BLOG</a>
                <span class="cyber-bracket">]</span>
            </div>
        </header>

        <main class="main-content">
            <section class="blog-header">
                <h1 class="page-title">@pageTitle</h1>
                <p class="page-description">@pageDescription</p>
            </section>

            <section class="blog-grid">
                @foreach (var post in blogPosts)
                {
                    var postTitle = post.Value<string>("title");
                    var postSubtitle = post.Value<string>("subtitle");
                    var publishDate = post.Value<DateTime>("publishDate");
                    var postUrl = post.Url();
                    var tags = post.Value<string[]>("tags") ?? Array.Empty<string>();
                    
                    <article class="blog-card">
                        <div class="card-header">
                            <time class="post-date" datetime="@publishDate.ToString("yyyy-MM-dd")">
                                @publishDate.ToString("MMMM dd, yyyy")
                            </time>
                        </div>
                        <h2 class="post-title">
                            <a href="@postUrl">@postTitle</a>
                        </h2>
                        <p class="post-subtitle">@postSubtitle</p>
                        @if (tags.Any())
                        {
                            <div class="post-tags">
                                @foreach (var tag in tags)
                                {
                                    <span class="tag">@tag</span>
                                }
                            </div>
                        }
                        <a href="@postUrl" class="read-more">Read Article →</a>
                    </article>
                }
            </section>
        </main>

        <footer class="site-footer">
            <p>&copy; 2026 AI Agent | Umbraco Codegarden Demo</p>
        </footer>
    </div>
</body>
</html>