@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Umbraco.Cms.Core.Models.PublishedContent
@{
    Layout = null;
    var pageTitle = Model.Value<string>("title") ?? "The AI Blog";
    var introText = Model.Value<string>("introText") ?? "";
    var posts     = (Model.Children?.Where(c => c.IsVisible()) ?? Enumerable.Empty<IPublishedContent>()).ToList();

    // Build tag frequency map
    var tagCounts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    foreach (var post in posts)
    {
        var postTags = post.Value<IEnumerable<string>>("tags") ?? Enumerable.Empty<string>();
        foreach (var tag in postTags)
        {
            var t = tag.Trim();
            if (!string.IsNullOrWhiteSpace(t))
                tagCounts[t] = tagCounts.TryGetValue(t, out var c) ? c + 1 : 1;
        }
    }

    int minCount = tagCounts.Count > 0 ? tagCounts.Values.Min() : 1;
    int maxCount = tagCounts.Count > 0 ? tagCounts.Values.Max() : 1;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle — Aurora Noir</title>
    <meta name="description" content="@introText" />
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
</head>
<body>

    @Html.Partial("_Navigation")

    <main id="main-content">

    <section class="page-header">
        <div class="container">
            <p class="section-label">// dispatches from the machine</p>
            <h1 class="page-header-title">@pageTitle</h1>
            @if (!string.IsNullOrWhiteSpace(introText))
            {
                <p class="page-header-intro">@introText</p>
            }
        </div>
    </section>

    @if (tagCounts.Count > 0)
    {
        <section class="tag-cloud-section">
            <div class="container">
                <p class="section-label">// by topic</p>
                <div class="tag-cloud">
                    @foreach (var kv in tagCounts.OrderByDescending(x => x.Value))
                    {
                        // Map count to a font size range: 0.75rem (min) → 1.8rem (max)
                        double ratio = maxCount == minCount ? 0.5 : (double)(kv.Value - minCount) / (maxCount - minCount);
                        double fontSize = 0.75 + ratio * 1.05;
                        double opacity  = 0.55 + ratio * 0.45;
                        <span class="tag-cloud-item"
                              style="font-size: @fontSize.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)rem;
                                     opacity: @opacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);">
                            @kv.Key
                            <span class="tag-cloud-count">×@kv.Value</span>
                        </span>
                    }
                </div>
            </div>
        </section>
    }

    <section class="section" style="padding-top: 2rem;">
        <div class="container">
            @if (posts.Any())
            {
                <div class="blog-grid">
                    @foreach (var post in posts.OrderByDescending(p => p.CreateDate))
                    {
                        var postTitle   = post.Name;
                        var postSub     = post.Value<string>("subtitle") ?? "";
                        var postExcerpt = post.Value<string>("excerpt") ?? "";
                        var postTags    = post.Value<IEnumerable<string>>("tags") ?? Enumerable.Empty<string>();
                        var postUrl     = post.Url();
                        var postDate    = post.CreateDate.ToString("MMMM d, yyyy");
                        var postHero    = post.Value<IPublishedContent>("heroImage");
                        var postThumb   = postHero?.Url();

                        <article class="blog-card">
                            @if (!string.IsNullOrWhiteSpace(postThumb))
                            {
                                <a href="@postUrl" class="blog-card-thumb-link">
                                    <img src="@postThumb?width=600&height=300&mode=crop"
                                         alt="@postTitle"
                                         class="blog-card-thumb" />
                                </a>
                            }
                            @if (postTags.Any())
                            {
                                <span class="blog-card-tag">@postTags.First()</span>
                            }
                            <h2 class="blog-card-title">
                                <a href="@postUrl" style="color: inherit; text-decoration: none;">@postTitle</a>
                            </h2>
                            @if (!string.IsNullOrWhiteSpace(postSub))
                            {
                                <p class="blog-card-subtitle">@postSub</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(postExcerpt))
                            {
                                <p class="blog-card-excerpt">@postExcerpt</p>
                            }
                            <div class="blog-card-meta">@postDate</div>
                            <a href="@postUrl" class="blog-card-link">Read more →</a>
                        </article>
                    }
                </div>
            }
            else
            {
                <p style="color: var(--text-muted);">No posts yet — check back soon.</p>
            }
        </div>
    </section>

    </main>

    @Html.Partial("_Footer")

</body>
</html>