<Project>

  <!--
    Separate build output per site so the two instances (Development and Conductor)
    can build and run concurrently without locking each other's MyProject.exe.

    The site is selected with an MSBuild global property, SiteEnv, passed on the command
    line (-p:SiteEnv=...) so it reaches the *build* phase of `dotnet run`. Launch-profile
    environmentVariables such as ASPNETCORE_ENVIRONMENT do NOT flow into the build, which is
    why keying on ASPNETCORE_ENVIRONMENT did not work. Example invocations (one per site):

        dotnet run (launch profile Umbraco.Web.UI) with -p:SiteEnv=Development
        dotnet run (launch profile Conductor)      with -p:SiteEnv=Conductor

    These paths MUST be set in Directory.Build.props (imported before Microsoft.Common.props)
    so that BaseIntermediateOutputPath takes effect; setting it in the .csproj is too late and
    corrupts the intermediate (obj) output.

    When SiteEnv is not supplied (e.g. plain `dotnet build`) the default bin\/obj\ paths are used.
  -->
  <PropertyGroup Condition="'$(SiteEnv)' != ''">
    <BaseOutputPath>bin\$(SiteEnv)\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\$(SiteEnv)\</BaseIntermediateOutputPath>
  </PropertyGroup>

</Project>
