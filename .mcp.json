{
  "mcpServers": {
    "umbraco-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["@umbraco-cms/mcp-dev@latest"],
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0",
        "UMBRACO_CLIENT_ID": "umbraco-back-office-mcp",
        "UMBRACO_CLIENT_SECRET": "1234567890",
        "UMBRACO_BASE_URL": "http://localhost:14737",
        "UMBRACO_INCLUDE_TOOL_COLLECTIONS": "document-type,document,media,property-type,partial-view,static-file,stylesheet,temporary-file,imaging,template"
      },
      "tools": ["*"]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--viewport-size="
      ],
      "tools": ["*"]
    },
    "a11y-accessibility": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "a11y-mcp-server"
      ],
      "tools": ["*"]
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "tools": ["*"]
    }
  }
}
